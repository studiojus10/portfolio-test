# Mailer sidecar (contact form) — copy to .env and fill in.
# Gmail: create an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords) and use it as SMTP_PASS. Never commit .env.
#
# With SMTP_USER/SMTP_PASS unset, the mailer runs in LOG-ONLY mode: it accepts
# submissions and logs them but does not deliver email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studiojus10@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_TO=studiojus10@gmail.com
MAIL_FROM=Studio Jus10 <studiojus10@gmail.com>

# Optional abuse limits (defaults: 5 requests / 10 min per IP)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=600000
