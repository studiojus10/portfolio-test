---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Art & Design Portfolio"
  bodyClass="bg-surface-container-low text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
>
  <style is:global>
    /* ── Interior cylinder ─────────────────────────────────────────── */
    #home-hero-section {
      perspective: 900px;
      perspective-origin: 50% 42%;
      /* Near-white floor that matches the reflection fill (--room-reflection,
         painted in home-cylinder.js's #cyl-floor-tint gradient) exactly from
         the cylinder's base downward. The reflection cards paint an opaque
         --room-reflection below their coral band; if the floor were a
         different shade there, each mirrored card would read as a
         lighter/darker rectangle over the floor (a visible card outline).
         Keeping the floor === the fill from ~40% down makes the reflection
         dissolve into the floor with no rectangle edges, matching the
         reference's near-white glass floor. --room-reflection is pinned to
         equal --room-floor-far exactly in tokens.css for this reason — any
         divergence between the two reintroduces the seam. */
      background: linear-gradient(
        180deg,
        var(--room-floor-near) 0%,
        var(--room-floor-far) 40%,
        var(--room-floor-far) 100%
      );
      /* Fades out when the vertical side carousel reveals, so the two carousels
         are never on screen together (see home-hero.js checkReveal). */
      transition: opacity 0.4s ease;
    }
    #cyl-ring,
    #cyl-floor-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      transform-style: preserve-3d;
      z-index: 2;
    }
    #cyl-floor-ring {
      z-index: 1;
    }
    .cyl-card {
      position: absolute;
      left: 0;
      top: 0;
      width: 260px; /* set by JS */
      height: 400px; /* set by JS */
      transform-origin: 50% 50%;
      backface-visibility: hidden;
      will-change: transform, filter;
      text-decoration: none;
      /* Framed gallery print: white mat with a thin black line inset a few px
         from the edge (white · black · white · content), image on top and a
         caption band below it. The soft drop shadow adds depth AND feathers the
         rotated card edge, so it aliases far less than a hard opaque rectangle. */
      display: flex;
      flex-direction: column;
      background: var(--room-card-mat);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4); /* fixed: decorative card-elevation shadow, same in both themes (matches the lightbox-shadow pattern used across the photography pages) */
      padding: 11px; /* outer white (5) + black line (1) + inner white (5) */
    }
    /* The inset black frame line, sitting in the white mat.
       Drawn as an inset box-shadow, NOT `border: 1px solid`. Firefox
       mis-rasterizes a hairline border on a 3D-projected element: at some
       rotation angles the top and bottom border edges blow out and expand
       inward until they meet, filling the card with --room-frame-line (near
       black in the light theme) and leaving only a thin gap in the middle — a
       "shutter" closing over each card as it swings past. It is deterministic
       per angle, so it holds still if the ring is stopped there. Chrome is
       unaffected. An inset box-shadow paints the identical 1px line (the
       pseudo-element's box is the `inset: 5px` rect either way, and an inset
       shadow is drawn inside that same border box) but takes a rasterization
       path that does not blow out. Do not "simplify" this back to a border. */
    .cyl-card::before {
      content: "";
      position: absolute;
      inset: 5px;
      box-shadow: inset 0 0 0 1px var(--room-frame-line);
      pointer-events: none;
      z-index: 2;
    }
    .cyl-thumb {
      position: relative;
      /* Image takes the top ~74% of the card; the rest is white caption mat
         below it, so the cards read light (matching the original). */
      flex: 0 0 74%;
      min-height: 0;
      overflow: hidden;
    }
    .cyl-thumb img,
    .cyl-thumb video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1.1); /* zoom to fill, cropping any white scan borders */
      /* grayscale lives on the media (not the card) so brightness can stay on
         the card and the image can fade to colour on hover */
      filter: grayscale(1);
      transition: filter 0.5s ease;
    }
    /* Colour-activate the hovered card, matching the vertical carousel */
    .cyl-card:hover .cyl-thumb img,
    .cyl-card:hover .cyl-thumb video {
      filter: grayscale(0);
    }
    .cyl-frame {
      display: none; /* superseded by the mat + black frame on .cyl-card/.cyl-thumb */
    }
    /* Caption band: the white area below the photo (title at its top, white
       space beneath), never over the image. */
    .cyl-label {
      position: static;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden; /* keep the title inside the card on short viewports */
      padding: 8px 3px 0;
      display: flex;
      flex-direction: column;
      gap: 1px;
      background: transparent;
    }
    .cyl-t {
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--fg);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .cyl-c {
      font-size: 12px;
      color: var(--room-caption);
      font-weight: 600;
    }
    /* Larger caption text on desktop, but only when the viewport is tall enough
       that the cards aren't shrunk short (otherwise it overflows the card). */
    @media (min-width: 768px) and (min-height: 640px) {
      .cyl-t,
      .cyl-c {
        font-size: 15px;
      }
    }
    /* Progressive caption/mat degradation on short "squished" cards. The squish
       tier is set by measure() in home-cylinder.js as data-squish on the hero.
       Scoped to #cyl-ring so the reflection (#cyl-floor-ring) is untouched. */
    #home-hero-section[data-squish="tight"] #cyl-ring .cyl-card,
    #home-hero-section[data-squish="cn"] #cyl-ring .cyl-card,
    #home-hero-section[data-squish="none"] #cyl-ring .cyl-card {
      padding: 6px;
    }
    #home-hero-section[data-squish="cn"] #cyl-ring .cyl-t,
    #home-hero-section[data-squish="none"] #cyl-ring .cyl-t {
      display: none;
    }
    #home-hero-section[data-squish="none"] #cyl-ring .cyl-c {
      display: none;
    }
    /* Glass-floor reflection colour + fade rides on the reflection cards
       themselves, so it follows the cylinder's curved base EXACTLY at any
       resolution (a fixed screen-space gradient can't track the geometry).
       Each floor card is mirrored (scaleY(-1)), so in the card's own space
       `to top` runs from the reflection's top edge (the meeting line) down
       toward its bottom: coral at the top, dissolving to the floor colour as it
       descends. */
    /* Reflection cards drop their frame, white mat and shadow so the mirror
       shows NO hard card outline — just a faint ghost of the image, under the
       coral. */
    #cyl-floor-ring .cyl-card {
      background: transparent;
      box-shadow: none;
      /* No mat padding on the reflection so the image ghost reaches the card
         edges and neighbours tile with no gap (and no overlap needed). */
      padding: 0;
    }
    /* The reflection drops the frame, mat and caption (mirroring those made each
       reflection read as a distinct panel with hard seams). The image stays but
       is faint, so a soft ghost reflects — enough to read as a reflection — and
       the ::after (coral glow + white gap + fade) sits on top and dissolves it
       into the white floor. */
    #cyl-floor-ring .cyl-card::before,
    #cyl-floor-ring .cyl-label {
      display: none;
    }
    #cyl-floor-ring .cyl-thumb {
      opacity: 0.22;
    }
    /* Coral glow + white gap + fade to the white floor is ONE element shaped to
       the measured floor-line arc (an ellipse), so the red is perfectly smooth
       with no per-card seams. home-cylinder.js measures the arc from the card
       bottoms and sets/keeps this background in sync, so it stays reactive. */
    #cyl-floor-tint {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
    }
    /* Zoom photography thumbnails in the vertical carousel to crop white film borders */
    #vert-track img[src^="/assets/images/"] {
      transform: scale(1.25);
    }
    /* Frame overlay — rendered on top of the image/video via ::after */
    .vert-card > div:first-child {
      position: relative;
    }
    .vert-card > div:first-child::after {
      content: "";
      position: absolute;
      inset: 0;
      /* NOT --room-frame-line: that token's light value is a near-black
         dark grey (see tokens.css), so mapping this border to it would
         darken it in light mode — a visible regression the light-mode-no-op
         constraint forbids. */
      border: 5px solid #e6e6e6; /* fixed: decorative frame overlay drawn on top of the photo thumbnail, same in both themes (matches the print-frame treatment used across the photography pages) */
      pointer-events: none;
      z-index: 1;
    }
    .vert-card img,
    .vert-card video {
      filter: grayscale(1);
      transition: filter 0.5s ease;
    }
    .vert-card:hover img,
    .vert-card:hover video {
      filter: grayscale(0);
    }

    /* ── Mobile / touch refinements ──────────────────────────────────── */
    /* Touch devices have no hover, so the cylinder's prev/next controls would
       never appear. Keep them visible where hover isn't available. */
    @media (hover: none) {
      #carousel-prev,
      #carousel-next {
        opacity: 1;
      }
    }
    /* Justified text creates ugly rivers at phone widths — left-align it. */
    @media (max-width: 640px) {
      #about p {
        text-align: left;
      }
    }

    /* Silhouette: anchor the head to a fixed distance below the title text
       instead of scaling with viewport height. `bottom:-15vh` + this height puts
       the image top at a fixed px from the top (top = the subtracted px), so the
       head clears the text on short viewports and doesn't drift low on tall ones.
       The feet stay 15vh below the fold as before. */
    #hero-person {
      height: calc(115vh - 260px);
    }
    @media (max-width: 767px) {
      #hero-person {
        height: calc(115vh - 205px);
      }
    }
  </style>

  <!-- Page loader: covers everything until window.load fires -->
  <div
    id="page-loader"
    class="bg-surface-container-low"
    style="position:fixed;inset:0;z-index:999999;transition:opacity 0.5s ease;pointer-events:none;"
  >
  </div>

  <!-- Fixed full-viewport background photo — fades in after hero scrolls off screen -->
  <div
    id="page-bg-photo"
    aria-hidden="true"
    style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;opacity:0;pointer-events:none;"
  >
    <img
      src="/assets/home-hero/home-page-background.jpg"
      alt=""
      style="position:absolute;bottom:0;left:50%;transform:translateX(-50%) scale(1.15);transform-origin:center bottom;width:auto;height:100%;min-width:100%;object-fit:cover;object-position:center bottom;filter:grayscale(1);"
    />
    <!-- Red tint overlay -->
    <div
      style="position:absolute;inset:0;background:rgba(160,20,20,0.18);pointer-events:none; /* fixed: colour tint over the background photo, same in both themes */"
    >
    </div>
  </div>

  <!-- ── Full-Screen Hero: Carousel + Person Overlay ─────────────────────── -->
  <div
    id="home-hero-section"
    style="position: relative; height: 100vh; overflow: hidden; perspective: 1000px; perspective-origin: 50% 40%;"
  >
    <!-- Interior cylinder: ring of works, positioned in JS -->
    <div id="cyl-ring">
      <a href="/photography/colorado/twelve-views" class="cyl-card">
        <div class="cyl-thumb">
          <img
            src="/assets/carousel/TYPOLOGY-01.jpg"
            alt="Twelve Views of Pikes Peak"
          />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Twelve Views of Pikes Peak</span>
          <span class="cyl-c">派克峰十二景</span>
        </div>
      </a>
      <a href="/photography/film/memory" class="cyl-card">
        <div class="cyl-thumb">
          <img src="/assets/carousel/MEMORY-01.jpg" alt="Memory" />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Memory</span>
          <span class="cyl-c">记忆</span>
        </div>
      </a>
      <a href="/video/portrait" class="cyl-card">
        <div class="cyl-thumb">
          <video
            class="carousel-still"
            src="/assets/videos/thumbnail-videos/portrait-thumbnail.mp4"
            poster="/assets/posters/portrait-thumbnail.jpg"
            muted
            playsinline
            preload="none"></video>
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Portrait of a Musician</span>
          <span class="cyl-c">音乐家肖像</span>
        </div>
      </a>
      <a href="/art/sketches" class="cyl-card">
        <div class="cyl-thumb">
          <img src="/assets/carousel/SKETCH-3.jpg" alt="Sketches" />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Sketches</span>
          <span class="cyl-c">素描</span>
        </div>
      </a>
      <a href="/photography/film/home" class="cyl-card">
        <div class="cyl-thumb">
          <img src="/assets/carousel/FILM_MISC-01.jpg" alt="Home" />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Home</span>
          <span class="cyl-c">家</span>
        </div>
      </a>
      <a href="/video/winter" class="cyl-card">
        <div class="cyl-thumb">
          <video
            class="carousel-still"
            src="/assets/videos/thumbnail-videos/winter-scene-thumbnail.mp4"
            poster="/assets/posters/winter-scene-thumbnail.jpg"
            muted
            playsinline
            preload="none"></video>
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Winter Scene</span>
          <span class="cyl-c">冬景</span>
        </div>
      </a>
      <a href="/photography/nature/sanctuary" class="cyl-card">
        <div class="cyl-thumb">
          <img
            src="/assets/carousel/BUTTERFLIES-01.jpg"
            alt="Butterfly Sanctuary"
          />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Butterfly Sanctuary</span>
          <span class="cyl-c">蝴蝶圣地</span>
        </div>
      </a>
      <a href="/video/murder" class="cyl-card">
        <div class="cyl-thumb">
          <video
            class="carousel-still"
            src="/assets/videos/thumbnail-videos/murder-he-wrote-thumbnail.mp4"
            poster="/assets/posters/murder-he-wrote-thumbnail.jpg"
            muted
            playsinline
            preload="none"></video>
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Murder, He Wrote</span>
          <span class="cyl-c">他所写的谋杀</span>
        </div>
      </a>
      <a href="/photography/film" class="cyl-card">
        <div class="cyl-thumb">
          <img src="/assets/carousel/FILM_MISC-03.jpg" alt="Film" />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Film</span>
          <span class="cyl-c">胶片</span>
        </div>
      </a>
      <a href="/art/composers" class="cyl-card">
        <div class="cyl-thumb">
          <img src="/assets/carousel/COMPOSER-3.jpg" alt="Composers" />
          <span class="cyl-frame"></span>
        </div>
        <div class="cyl-label">
          <span class="cyl-t">Composers</span>
          <span class="cyl-c">作曲家</span>
        </div>
      </a>
    </div>
    <!-- Floor reflection ring (JS mirrors #cyl-ring into it) -->
    <div id="cyl-floor-ring" aria-hidden="true"></div>
    <div id="cyl-floor-tint" aria-hidden="true"></div>

    <!-- Navigation buttons (above all walls) -->
    <button
      id="carousel-prev"
      aria-label="Previous"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-20 bg-surface-container-lowest border border-rule w-10 h-10 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity duration-300 hover:bg-primary hover:text-white hover:border-primary"
    >
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button
      id="carousel-next"
      aria-label="Next"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-20 bg-surface-container-lowest border border-rule w-10 h-10 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity duration-300 hover:bg-primary hover:text-white hover:border-primary"
    >
      <span class="material-symbols-outlined">chevron_right</span>
    </button>

    <!-- Name overlay: centered above carousel -->
    <div
      id="hero-name-overlay"
      style="position:absolute;top:0;left:0;right:0;z-index:5;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;padding-top:0.75rem;pointer-events:none;transition:opacity 0.5s ease-out;"
    >
      <span
        id="hero-typewriter-name"
        class="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-background leading-none text-center"
      ></span>
      <div
        id="hero-subtitle"
        class="font-label-mono uppercase tracking-widest text-center mt-1 flex flex-col items-center gap-0.5"
        style="font-size:11px;opacity:0;transition:opacity 0.35s ease;"
      >
        <span>Digital Media Portfolio</span>
        <span
          class="font-cjk text-primary"
          style="font-size:13px;letter-spacing:0.05em;">数字媒体作品集</span
        >
      </div>
    </div>
  </div><!-- end home-hero-section -->

  <!-- Person silhouette: fixed so it can slide over the header below -->
  <img
    id="hero-person"
    src="/assets/home-hero/standing-person-away.png"
    alt=""
    style="position:fixed;bottom:-15vh;left:50%;transform:translateX(-50%);pointer-events:none;z-index:9999;will-change:transform,opacity;transition:opacity 0.5s ease-out;"
  />

  <!-- Header: hidden on load, slides up + fades in on scroll -->
  <div
    id="home-hero-header"
    class="flex flex-col justify-center px-8 py-6 w-full relative"
    style="opacity: 0; transform: translateY(50px);"
  >
    <!-- Translucent background layer — fades out on scroll independently of text -->
    <div
      id="hero-header-bg"
      style="position:absolute;inset:0;background:var(--room-scroll-veil);pointer-events:none;z-index:0;"
    >
    </div>
    <!-- Text content sits above the background layer -->
    <div style="position:relative;z-index:1;">
      <h1
        class="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-background leading-none flex flex-col"
      >
        <span>Justin Hughes</span>
        <span
          class="font-cjk text-primary text-3xl md:text-5xl mb-2 font-medium"
          >艺术叙事，重塑新生</span
        >
      </h1>
    </div>
  </div>

  <!-- ── Main Content ─────────────────────────────────────────────────────── -->
  <main class="w-full px-4 md:px-8 pb-4 md:pb-8">
    <!-- ── About Section ────────────────────────────────────────────────────── -->
    <section
      id="about"
      class="grid-4-mobile md:grid-12 bg-surface-container-lowest shadow-2xl py-6 mb-10 mt-[7.5vh] rounded-xl"
      style="max-width:60%;padding-left:2.5%;padding-right:2.5%;"
    >
      <div class="col-span-4 md:col-span-12 flex items-end gap-4 mb-4">
        <h2 class="font-display-lg italic text-4xl">About</h2>
        <span class="font-cjk text-2xl text-primary mb-1">关于我</span>
      </div>

      <div class="col-span-4 md:col-span-12">
        <!-- Photo floated top-right — text wraps around it -->
        <div
          class="border border-rule overflow-hidden float-right ml-4 mb-2"
          style="width:27.5%;"
        >
          <a
            href="/about"
            class="block relative overflow-hidden group/headshot mb-2"
            style="aspect-ratio:2/3;"
          >
            <img
              loading="lazy"
              src="/assets/me-photos/headshot-color.jpg"
              alt="Justin Hughes"
              class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-500"
            />
          </a>
          <a
            href="/about"
            class="flex justify-center items-center gap-1 p-2 group transition-colors"
            style="background:#c0392b; /* fixed: brand alert-red More button background, invariant across themes */ color:#fff; /* fixed: white text on the brand-red More button */"
          >
            <span
              class="font-label-caps text-[10px] uppercase tracking-widest"
              style="color:#fff; /* fixed: white text on the brand-red More button */"
              >More</span
            >
            <span
              class="material-symbols-outlined transform group-hover:translate-x-1 transition-transform"
              style="font-size:16px;color:#fff; /* fixed: white icon on the brand-red More button */"
              >arrow_forward</span
            >
          </a>
        </div>
        <!-- Text wraps around the photo -->
        <p
          class="font-label-mono text-[15px] leading-relaxed text-justify mb-3"
        >
          <span
            class="font-headline-md text-3xl float-left mr-2 mt-1 leading-none text-on-background"
            >J</span
          >
          ustin Hughes is a storyteller and digital media practitioner who recently
          graduated with a Bachelor of Innovation in Digital Media Communication at
          the University of Colorado Colorado Springs. His creative foundation was
          built through years spent in China and France studying language, design,
          culinary arts, and hospitality, developing a fluency in human experience
          that informs everything he makes.
        </p>
        <p
          class="font-label-mono text-[15px] leading-relaxed text-justify mb-3"
          style="text-indent:1.25rem;"
        >
          A multilingual, collaborative, and detail-oriented foundation taught
          him to communicate across cultural difference and craft experiences
          with precision and care. Fine dining, hospitality and education are
          fields that demand cross-disciplinary teamwork and clear leadership
          under pressure.
        </p>
        <p
          class="font-label-mono text-[15px] leading-relaxed text-justify"
          style="text-indent:1.25rem;"
        >
          Every project begins with a story: what does this need to say, and how
          should it feel? Justin brings cross-disciplinary thinking and a drive
          for innovation to brand communication, digital marketing, eCommerce,
          and visual direction; leading with narrative and building toward
          creative leadership roles where strategy and storytelling converge.
        </p>
        <div style="clear:both;"></div>
      </div>
    </section>

    <!-- ── Contact Section ──────────────────────────────────────────────────── -->
  </main>

  <!-- ── Vertical Side Carousel ────────────────────────────────────────────── -->
  <div
    id="vert-carousel-wrap"
    aria-hidden="true"
    style="position:fixed;right:0;top:0;height:100vh;overflow:hidden;z-index:9000;transform:translateX(110%);opacity:0;pointer-events:none;transition:transform 0.7s cubic-bezier(0.4,0,0.2,1),opacity 0.5s ease;box-shadow:-6px 0 12px rgba(0,0,0,0.12) /* fixed: panel's left-edge shadow, same in both themes */,6px 0 12px rgba(0,0,0,0.12) /* fixed: panel's right-edge shadow, same in both themes */;"
  >
    <div
      id="vert-track"
      style="position:absolute;top:0;left:0;right:0;display:flex;flex-direction:column;gap:5px;padding:5px 0;will-change:transform;"
    >
      <!-- 1: Twelve Views of Pikes Peak -->
      <a
        href="/photography/colorado/twelve-views"
        class="vert-card block shrink-0 border border-rule bg-surface"
      >
        <div style="aspect-ratio:1/1;overflow:hidden;">
          <img
            loading="lazy"
            src="/assets/carousel/TYPOLOGY-01.jpg"
            alt="Twelve Views of Pikes Peak"
            style="display:block;width:100%;height:100%;object-fit:cover;"
          />
        </div>
        <div
          style="padding:3px 8px;border-top:1px solid rgb(var(--c-rule) / 0.15);"
        >
          <span
            class="font-label-caps text-[9px] uppercase tracking-wider text-on-surface"
