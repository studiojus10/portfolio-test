---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Contact"
  bodyClass="bg-surface-container-low text-on-surface font-body-md antialiased selection:bg-primary selection:text-white min-h-screen flex flex-col"
>
  <main class="w-full px-4 md:px-8 py-6 flex flex-col flex-1">
    <!-- Header -->
    <section class="page-fade" style="--fd:0s;">
      <div
        class="border-b-2 border-on-background pb-3 flex flex-wrap items-end gap-x-4 gap-y-1"
      >
        <span
          class="font-display-lg text-on-background text-headline-lg-mobile md:text-headline-lg font-medium leading-none"
          >Contact</span
        >
        <h1 class="font-cjk text-2xl md:text-4xl text-primary leading-none">
          联系与合作
        </h1>
      </div>
      <p
        class="font-label-mono text-xs uppercase tracking-widest text-on-surface-variant mt-3"
      >
        Fast access to email, social connections, and collaboration inquiries.
      </p>
    </section>

    <!-- Email + Social, side by side on desktop so the page fits one screen -->
    <section class="mt-5 grid gap-5 md:grid-cols-2 items-stretch flex-1">
      <!-- Email + inquiry form -->
      <div
        class="border border-on-background bg-surface p-5 page-fade flex flex-col"
        style="--fd:0.12s;"
      >
        <h2 class="font-headline-md text-2xl mb-4">Email</h2>
        <a
          href="mailto:studiojus10@gmail.com"
          class="inline-flex items-center gap-3 bg-primary border border-primary text-white px-4 py-3 hover:bg-white hover:text-primary transition-colors duration-300 mb-4"
        >
          <span class="material-symbols-outlined">mail</span>
          studiojus10@gmail.com
        </a>
        <!-- Formspree-ready. Until a real form id replaces YOUR_FORM_ID, submit
             falls back to the visitor's mail client (see script below). -->
        <form
          id="inquiry-form"
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          class="flex flex-col gap-3"
        >
          <input
            type="hidden"
            name="_subject"
            value="Portfolio Inquiry from studiojus10.com"
          />
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="text"
              name="name"
              placeholder="Your name"
              required
              class="border border-on-background bg-surface-container-lowest px-3 py-2 font-label-mono text-[13px] w-full focus:outline-none focus:border-primary"
            />
            <input
              type="email"
              name="email"
              placeholder="Your email"
              required
              class="border border-on-background bg-surface-container-lowest px-3 py-2 font-label-mono text-[13px] w-full focus:outline-none focus:border-primary"
            />
          </div>
          <textarea
            name="message"
            placeholder="Your message"
            required
            rows="3"
            class="border border-on-background bg-surface-container-lowest px-3 py-2 font-label-mono text-[13px] w-full focus:outline-none focus:border-primary resize-none"
          ></textarea>
          <button
            type="submit"
            class="flex items-center justify-between bg-primary border border-primary text-white px-4 py-3 font-label-caps text-xs hover:bg-white hover:text-primary transition-colors duration-300"
          >
            <span>Send Message</span>
            <span class="material-symbols-outlined" style="font-size:16px;"
              >send</span
            >
          </button>
          <p
            id="inquiry-success"
            class="hidden font-label-mono text-[13px] text-primary"
          >
            Message sent — I'll be in touch soon.
          </p>
          <p
            id="inquiry-error"
            class="hidden font-label-mono text-[13px]"
            style="color:#c0392b;"
          >
            Something went wrong. Please email directly.
          </p>
        </form>
      </div>

      <!-- Social -->
      <div
        class="border border-on-background bg-surface p-5 page-fade flex flex-col"
        style="--fd:0.24s;"
      >
        <h2 class="font-headline-md text-2xl mb-4">Social</h2>
        <div class="flex flex-col gap-3 flex-1 justify-center">
          <a
            href="https://www.linkedin.com/in/justin-hughes-studiojus10"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 border border-on-background bg-surface-container-lowest hover:border-primary transition-colors duration-300 p-3"
          >
            <img
              src="/assets/me-photos/LinkedIn-profile.jpeg"
              alt="LinkedIn"
              class="w-14 h-14 md:w-16 md:h-16 object-cover shrink-0"
            />
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-headline-md text-base text-on-background"
                >LinkedIn</span
              >
              <span
                class="font-label-mono text-xs text-on-surface-variant truncate"
                >Justin Hughes</span
              >
            </div>
            <span
              class="material-symbols-outlined ml-auto text-on-surface-variant group-hover:text-primary transition-colors"
              style="font-size:18px;">arrow_outward</span
            >
          </a>
          <a
            href="https://www.youtube.com/@studiojus10"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 border border-on-background bg-surface-container-lowest hover:border-primary transition-colors duration-300 p-3"
          >
            <img
              src="/assets/me-photos/YouTube-profile.png"
              alt="YouTube"
              class="w-14 h-14 md:w-16 md:h-16 object-cover shrink-0"
            />
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-headline-md text-base text-on-background"
                >YouTube</span
              >
              <span
                class="font-label-mono text-xs text-on-surface-variant truncate"
                >@studiojus10</span
              >
            </div>
            <span
              class="material-symbols-outlined ml-auto text-on-surface-variant group-hover:text-primary transition-colors"
              style="font-size:18px;">arrow_outward</span
            >
          </a>
          <a
            href="https://www.instagram.com/studio.jus10?utm_source=qr"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 border border-on-background bg-surface-container-lowest hover:border-primary transition-colors duration-300 p-3"
          >
            <img
              src="/assets/me-photos/Instagram-profile.jpg"
              alt="Instagram"
              class="w-14 h-14 md:w-16 md:h-16 object-cover shrink-0"
            />
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-headline-md text-base text-on-background"
                >Instagram</span
              >
              <span
                class="font-label-mono text-xs text-on-surface-variant truncate"
                >@studio.jus10</span
              >
            </div>
            <span
              class="material-symbols-outlined ml-auto text-on-surface-variant group-hover:text-primary transition-colors"
              style="font-size:18px;">arrow_outward</span
            >
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer
    class="bg-on-background flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div
        class="font-headline-md text-base text-surface-container-lowest italic"
      >
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path></svg
        >
        <span>YouTube</span>
        <span class="font-cjk text-primary opacity-70">视频</span>
      </a>
      <a
        href="https://www.instagram.com/studio.jus10?utm_source=qr"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.5"
            cy="6.5"
            r="0.5"
            fill="currentColor"
            stroke="none"></circle></svg
        >
        <span>Instagram</span>
        <span class="font-cjk text-primary opacity-70">照片</span>
      </a>
    </div>
    <div>
      <span>© 2026 STUDIO JUS10</span>
    </div>
  </footer>

  <script>
    (function () {
      window.addEventListener("load", function () {
        document.querySelectorAll(".page-fade").forEach(function (el) {
          el.classList.add("visible");
        });
      });
    })();

    (function () {
      var form = document.getElementById("inquiry-form") as HTMLFormElement;
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var successMsg = document.getElementById("inquiry-success");
          var errorMsg = document.getElementById("inquiry-error");
          var data = new FormData(form);

          // Not yet wired to Formspree — hand the message to the visitor's mail
          // client so the button still does something useful.
          if (form.action.indexOf("YOUR_FORM_ID") !== -1) {
            var subject = encodeURIComponent(
              "Portfolio inquiry from " + (data.get("name") || "website"),
            );
            var body = encodeURIComponent(
              (data.get("message") || "") +
                "\n\n— " +
                (data.get("name") || "") +
                " (" +
                (data.get("email") || "") +
                ")",
            );
            window.location.href =
              "mailto:studiojus10@gmail.com?subject=" +
              subject +
              "&body=" +
              body;
            return;
          }

          fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          })
            .then(function (res) {
              if (res.ok) {
                form.reset();
                successMsg.classList.remove("hidden");
                errorMsg.classList.add("hidden");
              } else {
                errorMsg.classList.remove("hidden");
                successMsg.classList.add("hidden");
              }
            })
            .catch(function () {
              errorMsg.classList.remove("hidden");
              successMsg.classList.add("hidden");
            });
        });
      }
    })();
  </script>
</Base>

<style>
  .page-fade {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.75s ease,
      transform 0.75s ease;
    transition-delay: var(--fd, 0s);
  }
  .page-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
