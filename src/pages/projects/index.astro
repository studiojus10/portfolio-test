          y="84"
          width="60"
          height="18"
          rx="1"
          stroke="rgba(255,255,255,0.1)"
          fill="none"></rect>
      </svg>
    </div>
    <div class="float-el" data-vx="0.17" data-vy="0.28">
      <svg
        width="110"
        height="75"
        viewBox="0 0 110 75"
        fill="none"
        stroke="rgba(224,60,49,0.12)"
        stroke-width="1"
      >
        <rect x="0.5" y="0.5" width="109" height="74" rx="2"></rect>
        <line x1="0" y1="18" x2="110" y2="18"></line>
        <rect
          x="8"
          y="26"
          width="94"
          height="7"
          rx="1"
          fill="rgba(224,60,49,0.06)"></rect>
        <rect
          x="8"
          y="40"
          width="68"
          height="7"
          rx="1"
          fill="rgba(224,60,49,0.06)"></rect>
