---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Projects"
  bodyClass="text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
  bodyStyle="background: #0a0a0a; overflow-x: hidden;"
>
  <style is:global>
    .float-el {
      position: absolute;
      top: 0;
      left: 0;
      will-change: transform;
    }

    .reveal-item {
      opacity: 0;
      transform: translateY(60px);
      transition:
        opacity 1s ease,
        transform 1s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .project-card {
      width: 90vw;
      margin-left: auto;
      margin-right: auto;
      transform-origin: center center;
      will-change: transform, opacity;
      opacity: 0;
      transform: scale(0.88);
    }
    @media (min-width: 768px) {
      .project-card {
        width: 70vw;
      }
    }

    .cf-preview-img {
      transition: transform 0.5s ease;
    }
    .project-card:hover .cf-preview-img {
      transform: scale(1.04);
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       FIXED BACKGROUND — floating wireframe shapes
  ════════════════════════════════════════════════ -->
  <div
    id="projects-bg"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background: #0a0a0a; overflow: hidden; transform: translateZ(0);"
  >
    <!-- Slowest -->
    <div class="float-el" data-vx="0.13" data-vy="0.22">
      <svg
        width="200"
        height="130"
        viewBox="0 0 200 130"
        fill="none"
        stroke="rgba(255,255,255,0.09)"
        stroke-width="1"
      >
        <rect x="0.5" y="0.5" width="199" height="129" rx="3"></rect>
        <line x1="0" y1="22" x2="200" y2="22"></line>
        <circle cx="13" cy="11" r="4"></circle><circle cx="26" cy="11" r="4"
        ></circle><circle cx="39" cy="11" r="4"></circle>
        <rect x="53" y="5" width="95" height="12" rx="2"></rect>
        <rect
          x="8"
          y="32"
          width="184"
          height="9"
          rx="1"
          fill="rgba(255,255,255,0.04)"></rect>
        <rect
          x="8"
          y="49"
          width="140"
          height="7"
          rx="1"
          fill="rgba(255,255,255,0.04)"></rect>
        <rect
          x="8"
          y="64"
          width="108"
          height="7"
          rx="1"
          fill="rgba(255,255,255,0.04)"></rect>
        <rect
