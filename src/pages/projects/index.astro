    <div class="float-el" data-vx="0.54" data-vy="0.88">
      <svg
        width="52"
        height="52"
        viewBox="0 0 52 52"
        fill="none"
        stroke="rgba(224,60,49,0.14)"
        stroke-width="1.5"
      >
        <circle cx="26" cy="26" r="25"></circle>
        <line x1="26" y1="8" x2="26" y2="26" stroke-width="2"></line>
        <line x1="26" y1="26" x2="36" y2="32" stroke-width="1.5"></line>
        <circle cx="26" cy="26" r="3" fill="rgba(224,60,49,0.3)" stroke="none"
        ></circle>
      </svg>
    </div>
  </div>

  <!-- Dark overlay that deepens as user scrolls past the hero -->
  <div
    id="projects-dark-overlay"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: #0a0a0a; opacity: 0; pointer-events: none;"
  >
  </div>

  <!-- ═══════════════════════════════════════════════
       HERO — 100vh, "Projects" centered
  ════════════════════════════════════════════════ -->
  <section
    style="position: relative; z-index: 10; height: 100vh; display: flex; align-items: center; justify-content: center; pointer-events: none;"
  >
    <div
      id="hero-center-text"
      style="opacity: 0; transform: translateY(10px); transition: opacity 0.88s ease, transform 0.88s ease; text-align: center; margin-bottom: 25vh;"
    >
      <span
        style="
        font-family: 'Old Standard TT', 'Noto Serif SC', serif;
        font-size: clamp(56px, 10vw, 84px);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-weight: 700;
        color: #ffffff;
        display: block;
        text-shadow:
          0 0 24px rgba(0,0,0,0.98),
          0 0 48px rgba(0,0,0,0.90),
          0 2px  6px rgba(0,0,0,0.99);
      "
        >Projects</span
      >
      <span
        style="
        font-family: 'Noto Serif SC', serif;
        font-size: clamp(2rem, 6vw, 4.5rem);
        line-height: 1;
        letter-spacing: normal;
        font-weight: 400;
        color: #e03c31;
        display: block;
        text-shadow:
          0 0 24px rgba(0,0,0,0.98),
          0 0 48px rgba(0,0,0,0.90),
          0 2px  6px rgba(0,0,0,0.99);
      "
        >项目</span
      >
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PAGE CONTENT
  ════════════════════════════════════════════════ -->
  <main class="relative w-full pb-16 pt-8" style="z-index: 10;">
    <!-- Page header card — matches Photography / Video / Art header style -->
    <section
      class="page-hero-card reveal-item mb-8 border border-on-background/20 shadow-[0_8px_32px_rgba(0,0,0,0.28)]"
      style="background-color:rgba(246,243,242,0.70);"
    >
      <div class="grid gap-8 md:grid-cols-12 items-start px-4 md:px-8 py-8">
        <div class="md:col-span-7 flex flex-col gap-6">
          <div class="border-b-2 border-on-background pb-4">
            <span
              class="font-display-lg text-on-background text-headline-lg-mobile md:text-display-lg mb-2 font-medium"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18);">Projects</span
            >
            <h1
              class="font-cjk text-3xl md:text-5xl text-primary leading-none"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18);"
            >
              商业与概念创作
            </h1>
          </div>
          <p
            class="font-label-mono text-xs uppercase tracking-widest text-on-surface-variant"
            style="text-shadow:0 1px 3px rgba(0,0,0,0.15);"
          >
            Professional and concept work.
          </p>
        </div>
        <div class="md:col-span-5 flex flex-col justify-center">
          <div
            class="bg-surface-container-lowest border border-on-background p-6 shadow-sm"
          >
            <p class="font-headline-md text-on-background text-2xl mb-4">
              Work grounded in a specific brief, audience, and outcome.
            </p>
            <p class="font-label-mono text-xs leading-relaxed text-on-surface">
              Each project here begins with a real problem or client vision —
              brand identity, digital products, advertising, and technical
              demonstrations built with intention and executed with precision.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Project cards — scroll-driven spotlight, one per row -->
    <section class="flex flex-col" style="gap: 100px; padding-bottom: 60px;">
      <!-- Peak Pet and Home Care -->
      <a
        href="/projects/peak-pet"
        class="project-card group flex flex-col border border-on-background/30 bg-surface hover:bg-surface-container-low transition-colors duration-300 rounded-xl overflow-hidden shadow-[0_8px_48px_rgba(0,0,0,0.38)]"
      >
        <div
          class="flex items-center justify-center flex-shrink-0 overflow-hidden"
          style="height:320px;background:#6b2a10;"
        >
          <div
            style="background:#b05828;border:1px solid rgba(0,0,0,0.35);box-shadow:0 4px 24px rgba(0,0,0,0.35);padding:22px;"
          >
            <img
              src="/assets/projects/PeakPet/peakPet-logo-text.png"
              alt="Peak Pet and Home Care logo"
              class="cf-preview-img"
              style="width:374px;max-width:100%;height:auto;display:block;"
            />
          </div>
        </div>
        <div
          class="flex-1 px-8 pt-10 flex flex-col justify-between border-t border-on-background"
          style="padding-bottom:15px;"
        >
          <div>
            <div
              class="font-label-caps text-[12px] uppercase tracking-widest text-on-surface-variant mb-3"
            >
              Commercial Work
            </div>
            <h2
              class="font-headline-md text-3xl text-on-background mb-1 group-hover:text-primary transition-colors"
            >
              Peak Pet and Home Care
            </h2>
            <p class="font-cjk text-lg text-primary mb-4">宠物与家园</p>
            <p
              class="font-label-mono text-xs leading-relaxed text-on-surface-variant max-w-2xl"
            >
              A mock website and advertising campaign for a local pet care and
              home services company — exploring brand identity, visual language,
              and the editorial sensibility of small business marketing.
            </p>
          </div>
          <div
            class="mt-6 flex items-center gap-2 font-label-caps text-[13px] tracking-widest text-primary"
          >
            <span>View Project</span>
            <span
              class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
              style="font-size:14px;">arrow_forward</span
            >
          </div>
        </div>
      </a>

      <!-- Career Footprint -->
      <a
        href="/projects/career-footprint"
        class="project-card group flex flex-col border border-on-background/30 bg-surface hover:bg-surface-container-low transition-colors duration-300 rounded-xl overflow-hidden shadow-[0_8px_48px_rgba(0,0,0,0.38)]"
      >
        <div class="flex-shrink-0 overflow-hidden" style="height:320px;">
          <div
            style="display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;height:100%;gap:2px;background:#000;"
          >
            <img
              src="/assets/projects/CareerFootprint/cf-assets/Counter%20View%20at%20Night.jpeg"
              alt="Coffee shop at night — CareerFootprint demo environment"
              style="grid-row:1/3;width:100%;height:100%;object-fit:cover;display:block;"
              class="cf-preview-img"
            />
            <img
              src="/assets/projects/CareerFootprint/cf-assets/ChatGPT%20Image%20Apr%2023%2C%202025%2C%2007_36_33%20AM.png"
              alt="AI-generated character asset"
              style="width:100%;height:100%;object-fit:cover;display:block;"
              class="cf-preview-img"
            />
            <img
              src="/assets/projects/CareerFootprint/cf-assets/Base%20Background.jpeg"
              alt="AI-generated coffee shop background"
              style="width:100%;height:100%;object-fit:cover;display:block;"
              class="cf-preview-img"
            />
          </div>
        </div>
        <div
          class="flex-1 px-8 pt-10 flex flex-col justify-between border-t border-on-background"
          style="padding-bottom:15px;"
        >
          <div>
            <div
              class="font-label-caps text-[12px] uppercase tracking-widest text-on-surface-variant mb-3"
            >
              White-Page R&amp;D
            </div>
            <h2
              class="font-headline-md text-3xl text-on-background mb-1 group-hover:text-primary transition-colors"
            >
              Career Footprint
            </h2>
            <p class="font-cjk text-lg text-primary mb-4">职业足迹</p>
            <p
              class="font-label-mono text-xs leading-relaxed text-on-surface-variant max-w-2xl"
            >
              A generative AI platform for career assistance — procedurally
              creating an interactive workspace tailored to each user for job
              applications, career tracking, interview practice, and more.
            </p>
          </div>
          <div
            class="mt-6 flex items-center gap-2 font-label-caps text-[13px] tracking-widest text-primary"
          >
            <span>View Project</span>
            <span
              class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
              style="font-size:14px;">arrow_forward</span
            >
          </div>
        </div>
      </a>
    </section>
  </main>

  <footer
    class="bg-on-background flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div
        class="font-headline-md text-base text-surface-container-lowest italic"
      >
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
