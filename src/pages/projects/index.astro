      </svg>
    </div>

    <!-- Medium -->
    <div class="float-el" data-vx="0.30" data-vy="0.50">
      <svg
        width="162"
        height="106"
        viewBox="0 0 162 106"
        fill="none"
        stroke="rgba(255,255,255,0.08)"
        stroke-width="1"
        overflow="hidden"
      >
        <rect x="0.5" y="0.5" width="161" height="105" rx="3"></rect>
        <line x1="0" y1="20" x2="162" y2="20"></line>
        <circle cx="11" cy="10" r="4"></circle><circle cx="24" cy="10" r="4"
        ></circle><circle cx="37" cy="10" r="4"></circle>
        <image
          href="/assets/projects/projects-hero/PETS-4.jpg"
          x="8"
          y="30"
          width="146"
          height="66"
          preserveAspectRatio="xMidYMid slice"
          opacity="0.55"
        />
      </svg>
    </div>
    <div class="float-el" data-vx="0.33" data-vy="0.55">
      <svg
        width="130"
        height="90"
        viewBox="0 0 130 90"
        fill="none"
        stroke="rgba(224,60,49,0.08)"
        stroke-width="1"
        overflow="hidden"
      >
        <rect x="0.5" y="0.5" width="129" height="89" rx="2"></rect>
        <image
