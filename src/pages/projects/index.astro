        />
        <image
          href="/assets/projects/projects-hero/PETS-3.jpg"
          x="118"
          y="95"
          width="114"
          height="53"
          preserveAspectRatio="xMidYMid slice"
          opacity="0.55"
        />
      </svg>
    </div>
    <div class="float-el" data-vx="0.25" data-vy="0.41">
      <svg
        width="80"
        height="80"
        viewBox="0 0 80 80"
