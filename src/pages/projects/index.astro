    </div>

    <!-- Medium-fast -->
    <div class="float-el" data-vx="0.40" data-vy="0.66">
      <svg
        width="92"
        height="64"
        viewBox="0 0 92 64"
        fill="none"
        stroke="rgba(255,255,255,0.07)"
        stroke-width="1"
      >
        <rect x="0.5" y="0.5" width="91" height="63" rx="2"></rect>
        <line x1="0" y1="16" x2="92" y2="16"></line>
        <rect
          x="6"
          y="24"
          width="80"
          height="7"
          rx="1"
          fill="rgba(255,255,255,0.05)"></rect>
        <rect
          x="6"
          y="36"
          width="56"
          height="7"
          rx="1"
          fill="rgba(255,255,255,0.05)"></rect>
        <rect
          x="6"
          y="49"
          width="36"
          height="10"
          rx="1"
          stroke="rgba(255,255,255,0.12)"
          fill="none"></rect>
      </svg>
    </div>
    <div class="float-el" data-vx="0.43" data-vy="0.70">
      <svg
        width="62"
        height="46"
        viewBox="0 0 62 46"
        fill="none"
        stroke="rgba(224,60,49,0.12)"
        stroke-width="1"
      >
        <rect x="0.5" y="0.5" width="61" height="45" rx="2"></rect>
        <polyline
          points="8,30 18,18 30,24 42,12 54,20"
          stroke="rgba(224,60,49,0.35)"
          stroke-width="1.5"
          fill="none"></polyline>
        <circle
          cx="42"
          cy="12"
          r="2.5"
          fill="rgba(224,60,49,0.35)"
          stroke="none"></circle>
      </svg>
    </div>

    <!-- Fastest -->
    <div class="float-el" data-vx="0.50" data-vy="0.82">
      <svg
        width="172"
        height="115"
        viewBox="0 0 172 115"
        fill="none"
        stroke="rgba(255,255,255,0.06)"
        stroke-width="1"
        overflow="hidden"
      >
        <rect x="0.5" y="0.5" width="171" height="114" rx="3"></rect>
        <line x1="0" y1="22" x2="172" y2="22"></line>
