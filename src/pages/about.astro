---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - About"
  bodyClass="bg-surface-container-low text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
>
  <style is:global>
    .scroll-reveal {
      opacity: 0;
      transform: translateY(40px);
      transition:
        opacity 0.9s ease,
        transform 0.9s ease;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <!-- Background landscape: fixed so it persists behind all page content -->
  <img
    id="hero-bg"
    src="/assets/about-hero/pikes-peak-background.jpg"
    alt=""
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; will-change: transform, opacity; z-index: -1; opacity: 0;"
  />

  <!-- ── Parallax Hero ─────────────────────────────────────────────── -->
  <section
    id="about-parallax-hero"
    style="position: relative; height: 142vh; overflow: hidden;"
  >
    <!-- Layer 2: About header text — starts at head level, rises on scroll -->
    <div
      id="hero-title"
      style="position: absolute; top: 17%; left: 0; right: 0; padding: 0 2rem; will-change: transform; z-index: 10; text-align: center; opacity: 0;"
    >
      <span
        class="font-display-lg text-white text-headline-lg-mobile md:text-display-lg font-medium leading-none"
        style="display: block; text-shadow: 0 2px 24px rgba(0,0,0,0.5); /* fixed: title over the hero photo */"
        >About</span
      >
      <h1
        class="font-cjk text-primary leading-none"
        style="font-size: clamp(2rem, 6vw, 4.5rem);"
      >
        设计观点
      </h1>
    </div>

    <!-- Layer 3: Standing person PNG — in front of title, moves least -->
    <img
      id="hero-person"
      src="/assets/about-hero/standing-person.png"
      alt=""
      style="position: absolute; top: -30%; left: 0; width: 100%; height: 120%; object-fit: cover; object-position: center; will-change: transform, opacity; z-index: 15; opacity: 0;"
    />

    <!-- Bottom fade: transparent → bg-color (bottom-up), sits immediately above the solid gap -->
    <div
      class="hero-fade"
      style="position: absolute; bottom: 42vh; left: 0; right: 0; height: 35vh; pointer-events: none; z-index: 20;"
    >
    </div>
    <!-- Solid page-color fill between the two fades -->
    <div
      style="position: absolute; bottom: 17vh; left: 0; right: 0; height: 25vh; pointer-events: none; z-index: 22; background: var(--bg);"
    >
    </div>
    <!-- Reflection: bg-color → transparent (top-down), occupies the 17vh extension at the very bottom -->
    <div
      style="position: absolute; bottom: 0; left: 0; right: 0; height: 17vh; pointer-events: none; z-index: 21; background: linear-gradient(to bottom, var(--bg), transparent);"
    >
    </div>
  </section>

  <main class="w-full px-4 md:px-8 py-8">
    <section class="grid gap-8 md:grid-cols-12 items-start">
      <div class="md:col-span-7 flex flex-col gap-6">
        <p
          class="scroll-reveal font-label-mono text-xs uppercase tracking-widest text-on-background"
          style="text-shadow: 0 1px 3px rgba(0,0,0,0.35); /* fixed: decorative label shadow */ transition-delay: 0s;"
        >
          A compact profile of Justin's creative approach, cultural perspective,
          and craft.
        </p>

        <div
          class="scroll-reveal bg-surface-container-lowest border border-rule py-6 px-[2.5%] shadow-sm rounded-xl"
          style="transition-delay: 0.15s;"
        >
          <p class="font-headline-md text-2xl text-on-background mb-4 italic">
            A designer who frames experience through story, atmosphere, and
            detail.
          </p>
          <p
            class="font-label-mono text-[11pt] leading-relaxed text-justify mb-4"
          >
            <span
              class="font-headline-md text-3xl float-left mr-2 mt-1 leading-none text-on-background"
              >J</span
            >ustin Hughes is a digital media and communications professional
            whose creative perspective spans international education, culinary
            arts, language immersion, music, travel, and high-touch hospitality.
            His work sits at the intersection of culture and communication:
            understanding how people connect, what makes experiences memorable,
            and how story, design, sound, food, and language shape trust.
          </p>
          <p
            class="font-label-mono text-[11pt] leading-relaxed text-justify mb-4"
            style="text-indent:1.25rem;"
          >
            Raised in the United States and shaped through years in France and
            China, Justin brings lived cultural fluency to everything he makes.
            He has trained in elite culinary environments including multiple
            three-Michelin-star restaurants, achieved advanced Mandarin
            proficiency, developed French-language capability, and built
            client-facing service experiences grounded in empathy, craft, and
            precision.
          </p>
          <p
            class="font-label-mono text-[11pt] leading-relaxed text-justify"
            style="text-indent:1.25rem;"
          >
            His process begins by exploring concepts or ideas, then crafting
            stories through photography, video, design systems, and digital
            content that feel both intentional and effortless.
          </p>
        </div>
      </div>

      <div class="md:col-span-5 flex flex-col gap-6">
        <div
          class="scroll-reveal border border-rule overflow-hidden shadow-sm relative"
          style="transition-delay: 0.1s;"
        >
          <div
            style="position:absolute;inset:0;background:rgba(0,0,0,0.28);pointer-events:none;z-index:0; /* fixed: placeholder tint under the portrait photo */"
          >
          </div>
          <img
            src="/assets/about-hero/me-about.png"
            alt="Justin Hughes"
            class="w-full object-cover object-top relative"
            style="max-height: 480px; z-index: 1;"
          />
        </div>
        <div
          class="scroll-reveal flex flex-row gap-3 w-full"
          style="transition-delay: 0.25s;"
        >
          <a
            href="/assets/documents/Justin_Hughes_Resume.pdf"
            download
            class="flex-1 flex items-center justify-between bg-primary border border-primary px-4 py-3 text-white font-label-caps text-xs hover:bg-surface-container-lowest hover:text-primary transition-colors duration-300 shadow-sm"
          >
            <span>Download Resumé</span>
            <span class="material-symbols-outlined" style="font-size:16px;"
              >download</span
            >
          </a>
          <a
            href="/assets/documents/Justin_Hughes_CV.pdf"
            download
            class="flex-1 flex items-center justify-between bg-primary border border-primary px-4 py-3 text-white font-label-caps text-xs hover:bg-surface-container-lowest hover:text-primary transition-colors duration-300 shadow-sm"
          >
            <span>Download CV</span>
            <span class="material-symbols-outlined" style="font-size:16px;"
              >download</span
            >
          </a>
        </div>
      </div>
    </section>

    <!-- ── Bachelor of Innovation ──────────────────────────────────────── -->
    <section class="grid gap-8 md:grid-cols-12 items-start mt-10">
      <div class="md:col-span-6 flex flex-col gap-4">
        <p
          class="scroll-reveal font-label-caps text-xs uppercase tracking-widest text-on-background"
          style="transition-delay: 0s; text-shadow: 0 1px 3px rgba(0,0,0,0.35); /* fixed: decorative label shadow */"
        >
          About the Bachelor of Innovation
        </p>
        <a
          href="https://innovate.uccs.edu/"
          target="_blank"
          rel="noopener"
          class="scroll-reveal border border-rule overflow-hidden shadow-sm block"
          style="transition-delay: 0.15s;"
        >
          <img
            src="/assets/about-hero/FILM_MISC-17.jpg"
            alt="UCCS Bachelor of Innovation"
            class="w-full object-cover"
          />
        </a>
        <a
          href="https://innovate.uccs.edu/"
          target="_blank"
          rel="noopener"
          class="scroll-reveal flex items-center justify-between bg-primary border border-primary px-4 py-3 text-white font-label-caps text-xs hover:bg-surface-container-lowest hover:text-primary transition-colors duration-300"
          style="transition-delay: 0.3s;"
        >
          <span>Learn More</span>
          <span class="material-symbols-outlined" style="font-size:16px;"
            >arrow_forward</span
          >
        </a>
      </div>

      <div class="md:col-span-6">
        <div
          class="scroll-reveal bg-surface-container-lowest border border-rule py-6 px-[2.5%] shadow-sm rounded-xl"
          style="transition-delay: 0.2s;"
        >
          <p class="font-headline-md text-2xl text-on-background mb-4 italic">
            A Unique Kind of Education
          </p>
          <p
            class="font-label-mono text-[11pt] leading-relaxed text-justify mb-4"
          >
            <span
              class="font-headline-md text-3xl float-left mr-2 mt-1 leading-none text-on-background"
              >T</span
            >he UCCS Bachelor of Innovation (BI) is an internationally
            recognized, interdisciplinary degree, equivalent to a traditional
            Bachelor of Arts or Bachelor of Science, designed to develop
            creative problem-solvers and entrepreneurial thinkers. Accredited
            through the North Central Association of Colleges and Schools (with
            Engineering and Business tracks additionally accredited by ABET and
            AACSB), the Bachelor of Innovation blends a traditional
            undergraduate curriculum with practical coursework in innovation,
            teamwork, and entrepreneurship.
          </p>
          <p
            class="font-label-mono text-[11pt] leading-relaxed text-justify"
            style="text-indent:1.25rem;"
          >
            Students work on real projects with businesses, nonprofits, and
            campus partners, gaining hands-on experience that prepares them to
            turn ideas into real-world impact. Supporting more than twenty
            majors, the Bachelor of Innovation provides a flexible,
            collaborative pathway for students across disciplines to explore
            opportunities, build innovative solutions, and develop skills that
            translate directly into industry and community needs.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer
    class="bg-fixed-dark flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div class="font-headline-md text-base text-on-fixed-dark italic">
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path></svg
        >
        <span>YouTube</span>
        <span class="font-cjk text-primary opacity-70">视频</span>
      </a>
      <a
        href="https://www.instagram.com/studio.jus10?utm_source=qr"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.5"
            cy="6.5"
            r="0.5"
            fill="currentColor"
            stroke="none"></circle></svg
        >
        <span>Instagram</span>
        <span class="font-cjk text-primary opacity-70">照片</span>
      </a>
    </div>
    <div>
      <span>© 2026 STUDIO JUS10</span>
    </div>
  </footer>

  <script>
    import "@scripts/about.js";
  </script>
</Base>
