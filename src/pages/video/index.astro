---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Video"
  bodyClass="text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
  bodyStyle="background: #0a0a0a; /* fixed: permanently-dark cinema hero, theme-invariant */"
>
  <style is:global>
    @media (max-width: 767px) {
      /* Video stays position:fixed (full-screen background) — just force cover crop */
      #hero-video {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }
      /* Hide the desktop 150vh parallax spacer on mobile */
      #hero-spacer {
        display: none !important;
      }
    }
  </style>

  <!-- Fixed video background (50vh cover on mobile via CSS) -->
  <div
    id="hero-video-bg"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background: #0a0a0a; /* fixed: permanently-dark cinema hero */ display: flex; align-items: center; justify-content: center; overflow: hidden;"
  >
    <video
      id="hero-video"
      style="width: 100%; height: auto; display: block; opacity: 0; filter: saturate(1);"
      autoplay
      muted
      loop
      playsinline
    >
      <source
        src="/assets/videos/auto-play/anamorphic_test.mp4"
        type="video/mp4"
      />
    </video>
  </div>

  <!-- Scroll-driven dark overlay -->
  <div
    id="hero-overlay"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: rgba(10,10,10,0); /* fixed: scroll-driven scrim over the hero video */ pointer-events: none;"
  >
  </div>

  <!-- Mobile-only cinematic hero — transparent, floats over fixed video background -->
  <div
    id="mobile-hero"
    class="md:hidden"
    style="position:relative; z-index:5; display:flex; flex-direction:column; justify-content:flex-end; padding:2rem 1.25rem 2.5rem; min-height:calc(100vh - 56px); background:linear-gradient(to top, rgba(10,10,10,0.82) 0% /* fixed: scrim base, holds the title legible */, rgba(10,10,10,0.25) 55% /* fixed: scrim midpoint fade */, rgba(10,10,10,0) 100% /* fixed: scrim clears near the top of the frame */);"
  >
    <div
      style="border-bottom:2px solid rgba(255,255,255,0.18); padding-bottom:1rem; margin-bottom:1.25rem; /* fixed: divider over the hero video */"
    >
      <span
        style="font-family:'Old Standard TT','Noto Serif SC',serif; font-size:clamp(48px,14vw,72px); font-weight:700; line-height:1; letter-spacing:-0.02em; color:#ffffff; /* fixed: title over the hero video */ text-shadow:0 0 24px rgba(0,0,0,0.85) /* fixed: outer glow keeps the title legible */, 0 2px 6px rgba(0,0,0,0.95) /* fixed: tight drop shadow for edge contrast */; display:block;"
        >Video</span
      >
      <span
        style="font-family:'Noto Serif SC',serif; font-size:clamp(1.8rem,8vw,3rem); font-weight:400; line-height:1; color:#e03c31; display:block; margin-top:-0.1em; /* fixed: brand red over the hero video */"
        >电影感叙事</span
      >
    </div>
    <p
      style="font-family:'Space Grotesk',sans-serif; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); /* fixed: text over the hero video */"
    >
      A concise showcase of motion, rhythm, and cinematic tone.
    </p>
  </div>

  <!-- Hero: 150vh spacer (hidden on mobile) -->
  <section
    id="hero-spacer"
    style="position: relative; z-index: 10; height: 150vh; pointer-events: none;"
  >
    <!-- "Video" title fades in on load, positioned just below the video frame -->
    <div
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100vh; overflow: hidden; pointer-events: none;"
    >
      <div
        id="video-load-title"
        style="position: absolute; left: 5%; top: 70%; opacity: 0; text-align: left;"
      >
        <span
          style="
          font-family: 'Old Standard TT', 'Noto Serif SC', serif;
          font-size: clamp(56px, 10vw, 84px);
          font-weight: 700;
          line-height: 1;
          letter-spacing: -0.02em;
          color: #ffffff; /* fixed: title over the hero video */
          text-shadow: 0 0 24px rgba(0,0,0,0.85) /* fixed: outer glow keeps the title legible */, 0 0 48px rgba(0,0,0,0.70) /* fixed: wider glow for softness */, 0 2px 6px rgba(0,0,0,0.95) /* fixed: tight drop shadow for edge contrast */;
          display: block;
        "
          >Video</span
        >
        <span
          style="
          font-family: 'Noto Serif SC', serif;
          font-size: clamp(2rem, 6vw, 4.5rem);
          font-weight: 400;
          line-height: 1;
          margin-top: -0.3em;
          color: #e03c31; /* fixed: brand red over the hero video */
          display: block;
          text-align: center;
          text-shadow: 0 2px 12px rgba(0,0,0,0.7); /* fixed: legibility scrim over the hero video */
        "
          >电影感叙事</span
        >
      </div>
    </div>

    <div
      id="hero-content"
      style="position: sticky; top: calc(100vh - 18rem); left: 0; right: 0; opacity: 0; transform: translateY(40px); pointer-events: auto;"
    >
      <div
        class="page-hero-card grid gap-8 md:grid-cols-12 items-start px-4 md:px-8 py-8"
        style="background-color: rgb(var(--c-surface-container-low) / 0.70);"
      >
        <div class="md:col-span-7 flex flex-col gap-6">
          <div class="border-b-2 border-rule pb-4">
            <span
              class="font-display-lg text-on-background text-headline-lg-mobile md:text-display-lg mb-2 font-medium"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18); /* fixed: decorative card-title shadow */"
              >Video</span
            >
            <h1
              class="font-cjk text-3xl md:text-5xl text-primary leading-none"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18); /* fixed: decorative card-title shadow */"
            >
              电影感叙事
            </h1>
          </div>
          <p
            class="font-label-mono text-xs uppercase tracking-widest text-on-surface-variant"
            style="text-shadow:0 1px 3px rgba(0,0,0,0.15); /* fixed: decorative card-title shadow */"
          >
            A concise showcase of motion, rhythm, and cinematic tone.
          </p>
        </div>
        <div class="md:col-span-5 flex flex-col gap-6">
          <div
            class="bg-surface-container-lowest border border-rule p-6 shadow-sm"
          >
            <p class="font-headline-md text-2xl text-on-background mb-4">
              Crafting moving images with editorial precision.
            </p>
            <p class="font-label-mono text-xs leading-relaxed text-on-surface">
              Every edit and frame is designed to read like a still image in
              motion. The red accent is used to punctuate energy, while the
              black-and-white palette creates contrast between stillness and
              movement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating content scrolls over the video -->
  <main class="relative w-full px-4 md:px-8 pb-16 pt-8" style="z-index: 10;">
    <section class="flex flex-col gap-12">
      <!-- 1 — image left -->
      <a
        href="/video/dublin"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/proposal-thumbnail.mp4"
            poster="/assets/posters/proposal-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">
            A Proposal in Dublin, Ireland
          </h2>
          <p class="font-cjk text-sm text-primary">都柏林求婚</p>
          <p class="font-label-mono text-xs leading-relaxed">
            A personal artistic film documenting an intimate moment in Dublin,
            scored with original music composed and performed by the filmmaker.
          </p>
        </div>
      </a>

      <!-- 2 — image right -->
      <a
        href="/video/winter"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row-reverse hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/winter-scene-thumbnail.mp4"
            poster="/assets/posters/winter-scene-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">Winter Scene</h2>
          <p class="font-cjk text-sm text-primary">冬景</p>
          <p class="font-label-mono text-xs leading-relaxed">
            A collage of winter footage captured through an anamorphic lens — a
            nostalgic and cinematic study of Colorado snow, light, and
            stillness.
          </p>
        </div>
      </a>

      <!-- 3 — image left -->
      <a
        href="/video/collage"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/collage-thumbnail.mp4"
            poster="/assets/posters/collage-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">
            A Collage of Found Footage
          </h2>
          <p class="font-cjk text-sm text-primary">发现素材拼贴</p>
          <p class="font-label-mono text-xs leading-relaxed">
            Fragments of incidental footage, old TV commercials and PSAs
            assembled with narrative logic, tied together with narration — an
            experiment in how meaning emerges from juxtaposition and
            perspective.
          </p>
        </div>
      </a>

      <!-- 4 — image right -->
      <a
        href="/video/portrait"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row-reverse hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/portrait-thumbnail.mp4"
            poster="/assets/posters/portrait-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">
            Portrait of a Musician
          </h2>
          <p class="font-cjk text-sm text-primary">音乐家肖像</p>
          <p class="font-label-mono text-xs leading-relaxed">
            An observational study of a musician at work — camera lingering on
            hands, breath, and the endless dedication required for perfection,
            rather than the performance itself. A story is told through intimate
            efforts of preperation and narrated letter from the musician to her
            best friend.
          </p>
        </div>
      </a>

      <!-- 5 — image left -->
      <a
        href="/video/single-shot"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/single-shot-thumbnail.mp4"
            poster="/assets/posters/single-shot-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">
            A Study of Light in One Shot
          </h2>
          <p class="font-cjk text-sm text-primary">一镜光影研究</p>
          <p class="font-label-mono text-xs leading-relaxed">
            A single unbroken take with no edit — the subject is light itself,
            shifting, changing, and captivating an unknown spectator.
          </p>
        </div>
      </a>

      <!-- 6 — image right -->
      <a
        href="/video/resurrection"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row-reverse hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/resurrection-thumbnail.mp4"
            poster="/assets/posters/resurrection-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">Resurrection</h2>
          <p class="font-cjk text-sm text-primary">复活</p>
          <p class="font-label-mono text-xs leading-relaxed">
            An experimental short built around transformation and return — form
            dissolving and reassembling through image and sound rather than
            story. A visual set to a poem.
          </p>
        </div>
      </a>

      <!-- 7 — image left -->
      <a
        href="/video/murder"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/murder-he-wrote-thumbnail.mp4"
            poster="/assets/posters/murder-he-wrote-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">Murder, He Wrote</h2>
          <p class="font-cjk text-sm text-primary">他所写的谋杀</p>
          <p class="font-label-mono text-xs leading-relaxed">
            A narrative short in the noir tradition — shadow, unreliable
            language, and a plot that unfolds more like a confession than a
            story.
          </p>
        </div>
      </a>

      <!-- 8 — image right -->
      <a
        href="/video/decadance"
        class="video-card bg-background rounded-xl overflow-hidden border border-rule/30 shadow-[0_8px_32px_rgba(0,0,0,0.28)] flex flex-col md:flex-row-reverse hover:shadow-[0_12px_48px_rgba(0,0,0,0.38)] transition-shadow duration-300 cursor-pointer"
      >
        <div class="w-full md:w-[60%] overflow-hidden flex-shrink-0">
          <video
            class="card-thumb-video w-full h-full object-cover"
            style="min-height: 199px; display: block;"
            src="/assets/videos/thumbnail-videos/decadance-thumbnail.mp4"
            poster="/assets/posters/decadance-thumbnail.jpg"
            muted
            loop
            playsinline
            preload="metadata"></video>
        </div>
        <div class="p-8 flex flex-col justify-center gap-3">
          <h2 class="font-headline-md text-2xl italic">Decadance</h2>
          <p class="font-cjk text-sm text-primary">颓废之舞</p>
          <p class="font-label-mono text-xs leading-relaxed">
            A narrative short where movement becomes the language —
            choreography, indulgence, and consequence told through the body
            rather than dialogue.
          </p>
        </div>
      </a>
    </section>
  </main>

  <footer
    class="bg-fixed-dark flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div class="font-headline-md text-base text-on-fixed-dark italic">
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path></svg
        >
        <span>YouTube</span>
        <span class="font-cjk text-primary opacity-70">视频</span>
      </a>
      <a
        href="https://www.instagram.com/studio.jus10?utm_source=qr"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.5"
            cy="6.5"
            r="0.5"
            fill="currentColor"
            stroke="none"></circle></svg
        >
        <span>Instagram</span>
        <span class="font-cjk text-primary opacity-70">照片</span>
      </a>
    </div>
    <div>
      <span>© 2026 STUDIO JUS10</span>
    </div>
  </footer>

  <script>
    import "@scripts/video.js";
  </script>
</Base>
