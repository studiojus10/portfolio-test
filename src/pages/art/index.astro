---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Art"
  bodyClass="text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
  bodyStyle="background: #0a0a0a; /* fixed: permanently-dark cinema hero, theme-invariant */ overflow-x: hidden;"
>
  <style is:global>
    .float-el {
      position: absolute;
      top: 0;
      left: 0;
      will-change: transform;
    }
    .float-img {
      display: block;
      height: auto;
      opacity: 0;
      transition: opacity 0.8s ease;
    }

    .reveal-item {
      opacity: 0;
      transform: translateY(60px);
      transition:
        opacity 1s ease,
        transform 1s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .series-img-wrap {
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }
    .series-img-wrap img {
      width: 100%;
      height: auto;
      display: block;
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       FIXED BACKGROUND — drifts behind the whole page
       Each image has data-vx (rightward px/frame) and
       data-vy (downward px/frame). All positive so every
       image travels top-left → bottom-right. Speed varies
       per image to create depth.
  ════════════════════════════════════════════════ -->
  <div
    id="art-bg"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background: #0a0a0a; /* fixed: permanently-dark cinema hero */ overflow: hidden; transform: translateZ(0);"
  >
    <!-- Slowest — feel far away -->
    <div class="float-el" data-vx="0.15" data-vy="0.25">
      <img
        class="float-img"
        src="/assets/art/composers/COMPOSER-3.jpg"
        alt=""
        style="width:150px;"
      />
    </div>
    <div class="float-el" data-vx="0.17" data-vy="0.28">
      <img
        class="float-img"
        src="/assets/art/composers/COMPOSER-2.jpg"
        alt=""
        style="width:120px;"
      />
    </div>

    <!-- Medium-slow -->
    <div class="float-el" data-vx="0.23" data-vy="0.38">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-12.jpg"
        alt=""
        style="width:130px;"
      />
    </div>
    <div class="float-el" data-vx="0.25" data-vy="0.42">
      <img
        class="float-img"
        src="/assets/art/composers/COMPOSER-1.jpg"
        alt=""
        style="width:110px;"
      />
    </div>
    <div class="float-el" data-vx="0.27" data-vy="0.44">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-7.jpg"
        alt=""
        style="width:140px;"
      />
    </div>

    <!-- Medium -->
    <div class="float-el" data-vx="0.31" data-vy="0.52">
      <img
        class="float-img"
        src="/assets/art/composers/COMPOSER-4.jpg"
        alt=""
        style="width:105px;"
      />
    </div>
    <div class="float-el" data-vx="0.34" data-vy="0.56">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-3.jpg"
        alt=""
        style="width:125px;"
      />
    </div>
    <div class="float-el" data-vx="0.35" data-vy="0.58">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-16.jpg"
        alt=""
        style="width:115px;"
      />
    </div>

    <!-- Medium-fast -->
    <div class="float-el" data-vx="0.41" data-vy="0.68">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-10.jpg"
        alt=""
        style="width:135px;"
      />
    </div>
    <div class="float-el" data-vx="0.43" data-vy="0.72">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-5.jpg"
        alt=""
        style="width:100px;"
      />
    </div>

    <!-- Fastest — feel close -->
    <div class="float-el" data-vx="0.50" data-vy="0.82">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-14.jpg"
        alt=""
        style="width:160px;"
      />
    </div>
    <div class="float-el" data-vx="0.54" data-vy="0.90">
      <img
        class="float-img"
        src="/assets/art/sketches/SKETCH-1.jpg"
        alt=""
        style="width:118px;"
      />
    </div>
  </div>

  <!-- Dark overlay that deepens as user scrolls past the hero -->
  <div
    id="art-dark-overlay"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: #0a0a0a; /* fixed: deepens the dark hero on scroll */ opacity: 0; pointer-events: none;"
  >
  </div>

  <!-- ═══════════════════════════════════════════════
       HERO SPACER — 100vh, transparent, shows background.
       "Art" text is centred here and scrolls away naturally.
  ════════════════════════════════════════════════ -->
  <section
    style="position: relative; z-index: 10; height: 100vh; display: flex; align-items: center; justify-content: center; pointer-events: none;"
  >
    <div
      id="hero-center-text"
      style="opacity: 0; transform: translateY(10px); transition: opacity 0.88s ease, transform 0.88s ease; text-align: center; margin-bottom: 25vh;"
    >
      <span
        style="
        font-family: 'Old Standard TT', 'Noto Serif SC', serif;
        font-size: clamp(56px, 10vw, 84px);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-weight: 700;
        color: #ffffff; /* fixed: text over the dark hero */
        display: block;
        text-shadow: 0 0 24px rgba(0,0,0,0.98) /* fixed: outer glow keeps the title legible */, 0 0 48px rgba(0,0,0,0.90) /* fixed: wider glow for softness */, 0 2px 6px rgba(0,0,0,0.99) /* fixed: tight drop shadow for edge contrast */;
      "
        >Art</span
      >
      <span
        style="
        font-family: 'Noto Serif SC', serif;
        font-size: clamp(2rem, 6vw, 4.5rem);
        line-height: 1;
        letter-spacing: normal;
        font-weight: 400;
        color: #e03c31; /* fixed: brand red */
        display: block;
        text-shadow: 0 0 24px rgba(0,0,0,0.98) /* fixed: outer glow keeps the title legible */, 0 0 48px rgba(0,0,0,0.90) /* fixed: wider glow for softness */, 0 2px 6px rgba(0,0,0,0.99) /* fixed: tight drop shadow for edge contrast */;
      "
        >艺术</span
      >
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PAGE CONTENT — scrolls over the fixed background.
       Each block has its own solid background so it reads
       cleanly above the drifting images.
  ════════════════════════════════════════════════ -->
  <main class="relative w-full pb-16 pt-8" style="z-index: 10;">
    <!-- Component 1: page header (matches the video page's hero content card) -->
    <section
      class="page-hero-card reveal-item mb-8 border border-rule/20 shadow-[0_8px_32px_rgba(0,0,0,0.28)]"
      style="background-color: rgb(var(--c-surface-container-low) / 0.70);"
    >
      <div class="grid gap-8 md:grid-cols-12 items-start px-4 md:px-8 py-8">
        <div class="md:col-span-7 flex flex-col gap-6">
          <div class="border-b-2 border-rule pb-4">
            <span
              class="font-display-lg text-on-background text-headline-lg-mobile md:text-display-lg mb-2 font-medium"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18); /* fixed: decorative card-title shadow */"
              >Art</span
            >
            <h1
              class="font-cjk text-3xl md:text-5xl text-primary leading-none"
              style="text-shadow:0 1px 4px rgba(0,0,0,0.18); /* fixed: decorative card-title shadow */"
            >
              视觉与概念
            </h1>
          </div>
          <p
            class="font-label-mono text-xs uppercase tracking-widest text-on-surface-variant"
            style="text-shadow:0 1px 3px rgba(0,0,0,0.15); /* fixed: decorative card-title shadow */"
          >
            A compact collection of concept work that balances form, narrative,
            and editorial restraint.
          </p>
        </div>
        <div class="md:col-span-5 flex flex-col justify-center">
          <div
            class="bg-surface-container-lowest border border-rule p-6 shadow-sm"
          >
            <p class="font-headline-md text-on-background text-2xl mb-4">
              Art direction anchored in storytelling and intentional contrast.
            </p>
            <p class="font-label-mono text-xs leading-relaxed text-on-surface">
              This page collects editorial art, installation stills, and visual
              identity work. The red palette appears as an accent, the
              typography is structured, and the composition is designed to feel
              both polished and raw.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Components 2 & 3: collection cards -->
    <section class="flex flex-col gap-12 px-[5%]">
      <a
        href="/art/sketches"
        class="reveal-item group flex flex-col md:flex-row border border-rule/30 bg-background hover:bg-surface-container-low transition-colors duration-300 rounded-xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.28)]"
      >
        <div class="series-img-wrap w-full md:w-[60%]">
          <img src="/assets/art/sketches/SKETCH-14.jpg" alt="Sketches" />
        </div>
        <div
          class="flex-1 px-6 md:px-10 py-8 flex flex-col justify-between border-t md:border-t-0 md:border-l border-rule"
        >
          <div>
            <div
              class="font-label-caps text-[13px] uppercase tracking-widest text-on-surface-variant mb-3"
            >
              Collection
            </div>
            <h2
              class="font-headline-md text-3xl text-on-background mb-1 group-hover:text-primary transition-colors"
            >
              Sketches
            </h2>
            <p class="font-cjk text-lg text-primary mb-4">素描</p>
            <p
              class="font-label-mono text-xs leading-relaxed text-on-surface-variant max-w-lg"
            >
              Hand-drawn pencil sketches — studies in form, line, and
              observation.
            </p>
          </div>
          <div
            class="mt-6 flex items-center gap-2 font-label-caps text-[13px] tracking-widest text-primary"
          >
            <span>View Collection</span>
            <span
              class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
              style="font-size:14px;">arrow_forward</span
            >
          </div>
        </div>
      </a>

      <a
        href="/art/composers"
        class="reveal-item group flex flex-col md:flex-row-reverse border border-rule/30 bg-background hover:bg-surface-container-low transition-colors duration-300 rounded-xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.28)]"
      >
        <div class="series-img-wrap w-full md:w-[60%]">
          <img src="/assets/art/composers/COMPOSER-2.jpg" alt="Composers" />
        </div>
        <div
          class="flex-1 px-6 md:px-10 py-8 flex flex-col justify-between border-t md:border-t-0 md:border-r border-rule"
        >
          <div>
            <div
              class="font-label-caps text-[13px] uppercase tracking-widest text-on-surface-variant mb-3"
            >
              Collection
            </div>
            <h2
              class="font-headline-md text-3xl text-on-background mb-1 group-hover:text-primary transition-colors"
            >
              Composers
            </h2>
            <p class="font-cjk text-lg text-primary mb-4">作曲家</p>
            <p
              class="font-label-mono text-xs leading-relaxed text-on-surface-variant max-w-lg"
            >
              Portrait sketches of the great composers — studies in character,
              intensity, and music.
            </p>
          </div>
          <div
            class="mt-6 flex items-center gap-2 font-label-caps text-[13px] tracking-widest text-primary"
          >
            <span>View Collection</span>
            <span
              class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
              style="font-size:14px;">arrow_forward</span
            >
          </div>
        </div>
      </a>
    </section>
  </main>

  <footer
    class="bg-fixed-dark flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div class="font-headline-md text-base text-on-fixed-dark italic">
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path></svg
        >
        <span>YouTube</span>
        <span class="font-cjk text-primary opacity-70">视频</span>
      </a>
      <a
        href="https://www.instagram.com/studio.jus10?utm_source=qr"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.5"
            cy="6.5"
            r="0.5"
            fill="currentColor"
            stroke="none"></circle></svg
        >
        <span>Instagram</span>
        <span class="font-cjk text-primary opacity-70">照片</span>
      </a>
    </div>
    <div>
      <span>© 2026 STUDIO JUS10</span>
    </div>
  </footer>

  <script>
    import "@scripts/art.js";
  </script>
</Base>
