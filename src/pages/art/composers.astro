---
import Base from "@layouts/Base.astro";
---

<Base
  title="STUDIO JUS10 - Composers"
  bodyClass="text-on-surface font-body-md antialiased selection:bg-primary selection:text-white"
  bodyStyle="background: #0f0e0d; /* fixed: permanently-dark gallery, theme-invariant */"
>
  <style is:global>
    .tilt-tile {
      perspective: 900px;
      perspective-origin: center center;
      cursor: pointer;
    }
    .tile-wrapper {
      will-change: transform, filter;
      border-radius: 0.375rem;
      overflow: hidden;
      transform-origin: center center;
      border: 1px solid #1c1b1b; /* fixed: frame line on the permanently-dark gallery */
      box-shadow: 0 0 18px 4px rgba(0, 0, 0, 0.28); /* fixed: decorative tile shadow */
    }
    .tile-wrapper img {
      width: 100%;
      height: auto;
      display: block;
    }
    @keyframes lightboxBloom {
      from {
        transform: scale(0.88);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .lb-strip {
      display: flex;
      gap: 6px;
      margin-top: 14px;
      overflow-x: auto;
      max-width: 100%;
      padding-bottom: 4px;
      scrollbar-width: thin;
      scrollbar-color: var(--faint) transparent;
    }
    .lb-strip::-webkit-scrollbar {
      height: 3px;
    }
    .lb-strip::-webkit-scrollbar-thumb {
      background: var(--faint);
      border-radius: 2px;
    }
    .lb-thumb {
      flex-shrink: 0;
      width: 48px;
      height: 36px;
      object-fit: cover;
      border-radius: 3px;
      opacity: 0.45;
      cursor: pointer;
      transition:
        opacity 0.2s,
        outline 0.2s,
        outline-offset 0.2s;
      outline: 2px solid transparent;
    }
    .lb-thumb.active {
      opacity: 1;
      outline: 3px solid var(--accent);
      outline-offset: 2px;
    }
  </style>

  <!-- Fixed background composer image -->
  <div
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background: #0f0e0d; /* fixed: permanently-dark gallery */ display: flex; align-items: center; justify-content: center; overflow: hidden;"
  >
    <img
      id="hero-bg-composer"
      src="/assets/art/composers/COMPOSER-2.jpg"
      alt=""
      style="width: 100%; height: auto; display: block; opacity: 0;"
    />
  </div>
  <div
    id="composer-overlay"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: rgba(10,10,10,0.1); /* fixed: scrim over the hero photo */ pointer-events: none;"
  >
  </div>

  <!-- Hero: 150vh with sticky header sliding in on scroll -->
  <section
    style="position: relative; z-index: 10; height: 150vh; pointer-events: none; background: linear-gradient(to top, rgba(8,8,8,0.92) 0%, transparent 52%); /* fixed: scrim over the hero photo */"
  >
    <div
      id="composer-hero-content"
      style="position: sticky; top: calc(100vh - 16rem); left: 0; right: 0; opacity: 0; transform: translateY(40px); pointer-events: auto; padding: 0 2rem 2rem;"
    >
      <div
        style="border-top: 2px solid rgba(255,255,255,0.5); padding-top: 1rem; /* fixed: divider over the hero photo */"
      >
        <a
          href="/art"
          class="font-label-caps text-[13px] uppercase tracking-widest hover:text-primary transition-colors inline-flex items-center gap-1 mb-3"
          style="color: rgba(255,255,255,0.6); /* fixed: link over the hero photo */"
        >
          <span class="material-symbols-outlined" style="font-size:14px;"
            >arrow_back</span
          >
          Art
        </a>
        <div class="flex items-end gap-4 mb-3">
          <span
            class="font-display-lg text-headline-lg-mobile md:text-display-lg font-medium leading-none"
            style="color: #fff; /* fixed: title over the hero photo */"
            >Composers</span
          >
          <h1
            class="font-cjk text-3xl md:text-5xl text-primary leading-none"
            style="margin-bottom: 4px;"
          >
            作曲家
          </h1>
        </div>
        <p
          class="font-label-mono text-xs uppercase tracking-widest"
          style="color: rgba(255,255,255,0.5); /* fixed: subtitle over the hero photo */"
        >
          Portrait sketches of the great composers — studies in character,
          intensity, and music.
        </p>
      </div>
    </div>
  </section>

  <!-- Scroll-tilted gallery on dark background -->
  <section
    class="w-full"
    style="position: relative; z-index: 10; background: #0f0e0d; /* fixed: permanently-dark gallery */ padding-top: 20vh; padding-bottom: 20vh;"
  >
    <div class="mx-auto px-6" style="max-width: 820px;">
      <div id="composer-gallery"></div>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 md:p-10"
    style="background-color:rgba(6,5,4,0.93);backdrop-filter:blur(10px); /* fixed: photo lightbox backdrop */"
  >
    <div
      id="lightbox-inner"
      class="relative flex flex-col items-center max-w-5xl w-full"
    >
      <button
        id="lightbox-close"
        aria-label="Close"
        style="position:absolute;top:-50px;right:0;color:#fff; /* fixed: close control over the always-dark lightbox backdrop */ background:none;border:none;cursor:pointer;padding:8px;opacity:0.8;transition:opacity 0.2s;"
        onmouseover="this.style.opacity=1"
        onmouseout="this.style.opacity=0.8"
      >
        <svg
          width="28"
          height="28"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
      <div class="relative w-full flex items-center justify-center">
        <button
          id="lightbox-prev"
          aria-label="Previous"
          style="position:absolute;left:0;z-index:10;color:#fff; /* fixed: lightbox control icon, always white */ background:rgba(0,0,0,0.45); /* fixed: translucent backdrop behind the control, same in both themes */ border:none;cursor:pointer;padding:12px;transition:background 0.2s;"
          onmouseover="this.style.background='rgba(0,0,0,0.75)' /* fixed: hover state over the lightbox backdrop */"
          onmouseout="this.style.background='rgba(0,0,0,0.45)' /* fixed: matches the default control colour over the lightbox backdrop */"
        >
          <svg
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path></svg
          >
        </button>
        <img
          id="lightbox-img"
          src=""
          alt=""
          style="max-height:78vh;max-width:100%;width:auto;border-radius:4px;box-shadow:0 30px 80px rgba(0,0,0,0.7); /* fixed: decorative shadow under the enlarged photo */"
        />
        <button
          id="lightbox-next"
          aria-label="Next"
          style="position:absolute;right:0;z-index:10;color:#fff; /* fixed: lightbox control icon, always white */ background:rgba(0,0,0,0.45); /* fixed: translucent backdrop behind the control, same in both themes */ border:none;cursor:pointer;padding:12px;transition:background 0.2s;"
          onmouseover="this.style.background='rgba(0,0,0,0.75)' /* fixed: hover state over the lightbox backdrop */"
          onmouseout="this.style.background='rgba(0,0,0,0.45)' /* fixed: matches the default control colour over the lightbox backdrop */"
        >
          <svg
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
        </button>
      </div>
      <p
        id="lightbox-caption"
        style="margin-top:14px;font-family:'Space Grotesk',sans-serif;font-size:10px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(255,255,255,0.7); /* fixed: caption over the always-dark lightbox backdrop */"
      >
      </p>
      <div class="lb-strip" id="lb-strip"></div>
    </div>
  </div>

  <footer
    class="bg-fixed-dark flex flex-col md:flex-row justify-between items-center px-4 md:px-8 py-6 w-full border-t-4 border-primary font-label-mono text-[13px] text-surface-variant uppercase tracking-widest"
    style="position:relative;z-index:10000;"
  >
    <div class="flex items-center gap-4 mb-4 md:mb-0">
      <div class="font-headline-md text-base text-on-fixed-dark italic">
        STUDIO JUS10
      </div>
      <div class="font-cjk text-primary border-l border-surface-variant pl-4">
        工作室
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row flex-wrap gap-x-5 gap-y-2 mb-4 md:mb-0 text-[10px]"
    >
      <a
        href="mailto:studiojus10@gmail.com"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><polyline
            points="2,4 12,13 22,4"></polyline></svg
        >
        <span>Email</span>
        <span class="font-cjk text-primary opacity-70">邮件</span>
      </a>
      <a
        href="https://www.linkedin.com/in/justin-hughes-studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zm1.957 13.019H3.379V9h3.915v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span>LinkedIn</span>
        <span class="font-cjk text-primary opacity-70">领英</span>
      </a>
      <a
        href="https://www.youtube.com/@studiojus10"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path></svg
        >
        <span>YouTube</span>
        <span class="font-cjk text-primary opacity-70">视频</span>
      </a>
      <a
        href="https://www.instagram.com/studio.jus10?utm_source=qr"
        target="_blank"
        rel="noopener"
        class="hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle
            cx="17.5"
            cy="6.5"
            r="0.5"
            fill="currentColor"
            stroke="none"></circle></svg
        >
        <span>Instagram</span>
        <span class="font-cjk text-primary opacity-70">照片</span>
      </a>
    </div>
    <div>
      <span>© 2026 STUDIO JUS10</span>
    </div>
  </footer>

  <script>
    import "@scripts/art-composers.js";
  </script>
</Base>
